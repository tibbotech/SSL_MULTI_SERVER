include "global.tbh"

dim tls_up(NUM_TLS_SOCKS) as no_yes    'YES once a socket has completed its TLS handshake

'------------------------------------------------------------------------------
sub on_sys_init()
    boot()
end sub

'------------------------------------------------------------------------------
sub boot()
    'Static IP configuration
    net.ip        = DEVICE_IP
    net.netmask   = DEVICE_MASK
    net.gatewayip = DEVICE_GW

    'Request buffers — sockets 0 to NUM_TLS_SOCKS-1
    dim i as byte
    for i = 0 to NUM_TLS_SOCKS - 1
        sock.num = i
        sock.rxbuffrq(TLS_RX_BUFF)
        sock.txbuffrq(TLS_TX_BUFF)
    next i

    sys.buffalloc()
    sys.debugprint("Buffer pages free after alloc: " + str(sys.freebuffpages) + "\r\n")

    'Configure each socket as a TCP listener
    for i = 0 to NUM_TLS_SOCKS - 1
        sock.num           = i
        sock.protocol      = PL_SOCK_PROTOCOL_TCP
        sock.localportlist = TLS_LISTEN_PORT
        sock.inconmode     = PL_SOCK_INCONMODE_ANY_IP_ANY_PORT
        sock.reconmode     = PL_SOCK_RECONMODE_1
        tls_up(i)          = NO
    next i

    sys.debugprint("SSL_MULTI_SERVER ready. Listening on port " + TLS_LISTEN_PORT + " (" + str(NUM_TLS_SOCKS) + " sockets)\r\n")
end sub

'------------------------------------------------------------------------------
'Returns the number of sockets that have completed the TLS handshake.
'(sock.statesimple is already PL_SSTS_EST as soon as TCP connects, so it cannot be used here.)
function count_active() as byte
    dim i as byte
    dim n as byte
    n = 0
    for i = 0 to NUM_TLS_SOCKS - 1
        if tls_up(i) = YES then n = n + 1
    next i
    count_active = n
end function

'------------------------------------------------------------------------------
sub on_sock_event(newstate as pl_sock_state, newstatesimple as pl_sock_state_simple)
    if sock.num < NUM_TLS_SOCKS then
        tls_server_event(newstate, newstatesimple)
    end if
end sub

'------------------------------------------------------------------------------
sub on_sock_data_arrival()
    if sock.num < NUM_TLS_SOCKS then
        tls_server_echo()
    end if
end sub

'------------------------------------------------------------------------------
sub tls_server_event(newstate as pl_sock_state, newstatesimple as pl_sock_state_simple)
    if newstatesimple = PL_SSTS_CLOSED then
        tls_up(sock.num) = NO
        sys.debugprint("sock[" + str(sock.num) + "] closed (state=" + str(newstate) + ") active: " + str(count_active()) + "/" + str(NUM_TLS_SOCKS) + "\r\n")
        sock.rxclear
        sock.txclear
        sock.tlsdeinit
        exit sub
    end if

    select case newstate
    case PL_SST_EST_POPENED:
        sys.debugprint("sock[" + str(sock.num) + "] TCP from " + sock.remoteip + ":" + str(sock.remoteport) + "\r\n")
        sock.tlsdeinit
        romfile.open(CERT_BUNDLE)
        dim tls_res as pl_tls_result = sock.tlsinit(romfile.offset)
        if tls_res <> PL_TLS_SUCCESS then
            sys.debugprint("sock[" + str(sock.num) + "] tlsinit FAILED (" + str(tls_res) + ")\r\n")
            sock.close
            exit sub
        end if
        tls_res = sock.tlshandshake("")
        if tls_res <> PL_TLS_SUCCESS then
            sys.debugprint("sock[" + str(sock.num) + "] tlshandshake FAILED (" + str(tls_res) + ")\r\n")
            sock.close
            exit sub
        end if
        sys.debugprint("sock[" + str(sock.num) + "] TLS handshake started...\r\n")

    case PL_SST_EST_TLS:
        tls_up(sock.num) = YES
        sys.debugprint("sock[" + str(sock.num) + "] TLS established. active: " + str(count_active()) + "/" + str(NUM_TLS_SOCKS) + "\r\n")
        sock.tlssetdata("Connected to SSL_MULTI_SERVER [sock " + str(sock.num) + "]. Send data to echo." + chr(13) + chr(10))
        sock.send

    case PL_SST_EST_TLS_FAILED:
        tls_up(sock.num) = NO
        sys.debugprint("sock[" + str(sock.num) + "] TLS handshake FAILED - resetting\r\n")
        sock.rxclear
        sock.reset
    end select
end sub

'------------------------------------------------------------------------------
sub tls_server_echo()
    if sock.statesimple <> PL_SSTS_EST then exit sub
    dim data as string
    data = sock.tlsgetdata(255)
    while len(data) > 0
        sys.debugprint("sock[" + str(sock.num) + "] RX[" + str(len(data)) + "]: " + data + "\r\n")
        sock.tlssetdata("ECHO: " + data)
        sock.send
        data = sock.tlsgetdata(255)
    wend
end sub
